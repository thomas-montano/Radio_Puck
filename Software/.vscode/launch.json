{
    /*
     * "Debug (probe-rs)" needs the probe-rs.probe-rs-debugger extension.
     * "Debug (OpenOCD)" needs marus25.cortex-debug, OpenOCD and arm-none-eabi-gdb.
     */
    "version": "0.2.0",
    "configurations": [
        {
            "type": "probe-rs-debug",
            "request": "launch",
            "name": "Debug (probe-rs)",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Cargo Build (debug)",
            "chip": "STM32F407VGTx",
            "flashingConfig": { "flashingEnabled": true },
            "coreConfigs": [
                {
                    "programBinary": "${workspaceFolder}/target/thumbv7em-none-eabihf/debug/radio-puck",
                    "rttEnabled": true
                }
            ]
        },
        {
            "type": "cortex-debug",
            "request": "launch",
            "name": "Debug (OpenOCD)",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Cargo Build (debug)",
            "runToEntryPoint": "main",
            "executable": "./target/thumbv7em-none-eabihf/debug/radio-puck",
            "device": "STM32F407VG",
            "configFiles": ["openocd.cfg"]
        }
    ]
}
